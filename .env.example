# Copy to .env and fill in. .env is gitignored; .envs/.local/ is NOT --the
# .gitignore un-ignores it-- so never put a secret there.
DJANGO_READ_DOT_ENV_FILE=True

# Cloudflare Stream.
# Account id and subdomain are public: they appear in every playback URL.
# The token is a credential. Create it at:
#   Cloudflare dashboard -> Manage account -> Account API tokens -> Create Token
#   -> Custom -> Account -> Stream -> Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_SUBDOMAIN=
CLOUDFLARE_STREAM_TOKEN=
